# Copy this file to .env and adjust the values for your environment.
# This service stores nothing itself — it has NO database configuration.

# +--------------------------------------------------------------------------+
# | LOGGING  (src.app.core.settings.logging.LoggingSettings)                 |
# +--------------------------------------------------------------------------+
LOG_LEVEL="INFO"          # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="json"         # json (production) | text (local development)

# +--------------------------------------------------------------------------+
# | HTTP / CORS  (src.app.core.settings.app.AppSettings)                     |
# +--------------------------------------------------------------------------+
# Comma-separated list of allowed origins. EMPTY by default (no cross-origin
# access). Set explicitly per environment; avoid "*" in production.
# CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# +--------------------------------------------------------------------------+
# | AUTH  (src.app.core.settings.security.SecuritySettings)                  |
# +--------------------------------------------------------------------------+
# API key REQUIRED in the X-API-Key header to call /api/v1/* (min length 16).
# /health/* stays open. Generate a strong random value in production.
# Shared placeholder across all five portfolio services — see OPS_CORE_API_KEY below.
SECURITY_API_KEY="change-me-min-16-chars"

# +--------------------------------------------------------------------------+
# | RATE LIMIT  (src.app.core.settings.rate_limit.RateLimitSettings)         |
# +--------------------------------------------------------------------------+
# Per-client (by IP) sliding-window throttle on /api/v1/* — protects LLM spend.
# In-memory / per-process; use Redis for a shared limit across instances.
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60.0

# +--------------------------------------------------------------------------+
# | UPSTREAM: ops-core-api  (src.app.core.settings.ops_core.OpsCoreSettings) |
# +--------------------------------------------------------------------------+
# Base URL of ops-core-api, WITHOUT the /api/v1 suffix.
# Outside docker use localhost; from a container use host.docker.internal.
OPS_CORE_BASE_URL="http://localhost:8000"
# API key sent as the X-API-Key header to ops-core-api (min length 16).
# The SAME placeholder is in all five services' .env.example, so `cp .env.example .env`
# gives a working demo out of the box. Rotate it in all five at once.
OPS_CORE_API_KEY="change-me-min-16-chars"
OPS_CORE_TIMEOUT_SECONDS=10.0
# TOTAL attempts including the first, not the number of repeats.
OPS_CORE_MAX_ATTEMPTS=3

# +--------------------------------------------------------------------------+
# | RAG BUSINESS RULES  (src.app.core.settings.rag.RagSettings)             |
# +--------------------------------------------------------------------------+
# Minimum similarity score (0..1, cosine) of the BEST retrieved chunk required
# to call the LLM. DEFAULT 0.5. If the best score is below this, the service
# returns the canned fallback below and NEVER calls the LLM — cost control plus
# honesty (no hallucinating on weak retrieval).
RAG_SCORE_THRESHOLD=0.5
# How many chunks to retrieve from ops-core-api per question.
RAG_TOP_K=5
# Max chunks injected into the LLM prompt as grounding context.
RAG_MAX_CONTEXT_CHUNKS=5
# Answer returned when retrieval confidence is below RAG_SCORE_THRESHOLD.
RAG_FALLBACK_MESSAGE="Не могу ответить точно, уточните у администратора."

# +--------------------------------------------------------------------------+
# | LLM  (src.app.core.settings.llm.LLMSettings)                            |
# +--------------------------------------------------------------------------+
# Provider profile: openai | openai_compatible | ollama
# Ollama is OpenAI-compatible: keep provider=ollama and point LLM_BASE_URL at it.
LLM_PROVIDER="ollama"
LLM_MODEL="qwen2.5:7b"
# LLM_API_KEY="your_api_key"    # required when LLM_PROVIDER=openai
# Outside docker use localhost; keep the /v1 suffix for OpenAI-compatible servers.
LLM_BASE_URL="http://localhost:11434/v1"
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=1024
